{
  "name": "hardcastle/ledger-direct-prestashop-dev",
  "description": "Development tooling for the LedgerDirect PrestaShop module. Kept out of the module's own vendor/, which PrestaShop autoloads on every request.",
  "license": "MIT",
  "type": "project",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "prestashop/php-dev-tools": "^5.0"
  },
  "autoload-dev": {
    "psr-4": {
      "LedgerDirect\\Tests\\": "../tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit",
    "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  }
}
